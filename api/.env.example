# General settings
NODE_ENV='development'
PORT=3000

# Database settings
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=verify-full&channel_binding=require"

#Observe settings
OBSERVE_APP_KEY="your-observe-app-key"
OBSERVE_APP_SECRET="your-observe-app-secret"

# Firebase settings
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_PRIVATE_KEY="your-private-key"
FIREBASE_CLIENT_EMAIL="your-email@example.com"

# Cloudflare R2 settings
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="incident-media"
R2_PUBLIC_URL="https://your-public-r2-domain.example"
