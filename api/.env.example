# General settings
NODE_ENV='development'
PORT=3000

# Database settings
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=verify-full&channel_binding=require"

#Observe settings
OBSERVE_APP_KEY="your-observe-app-key"
OBSERVE_APP_SECRET="your-observe-app-secret"

# Firebase settings
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_PRIVATE_KEY="your-private-key"
FIREBASE_CLIENT_EMAIL="your-email@example.com"

# Backblaze B2 private S3-compatible storage
STORAGE_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
STORAGE_REGION="eu-central-003"
STORAGE_ACCESS_KEY_ID="your-b2-key-id"
STORAGE_SECRET_ACCESS_KEY="your-b2-application-key"
STORAGE_BUCKET="incident-media-private"

# Jobs agendados (true por omissão)
JOBS_ENABLED=true


# Valkey local: redis://localhost:6379. In production use the Aiven rediss:// URI with TLS.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=reporta

# Proxy hops trusted when deriving the client IP for rate limits (default 0).
TRUST_PROXY_HOPS=0
