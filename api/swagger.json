    "/incidents": {
      "post": {
        "operationId": "IncidentsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIncidentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReturnIncidentDto"
                }
              }
            }
          }
        },
        "summary": "Cria um novo incidente.\nMétodo HTTP: POST /incidents",
        "tags": [
          "Incidents"
        ]
      },
      "get": {
        "operationId": "IncidentsController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Número da página de resultados a devolver.",
            "schema": {
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Número máximo de incidentes por página.",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "type": "number"
            }
          },
          {
            "name": "categoryId",
            "required": false,
            "in": "query",
            "description": "Identificador da categoria para filtrar os incidentes.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Texto livre para pesquisar no título ou na descrição do incidente.",
            "schema": {
              "minLength": 2,
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "mine",
            "required": false,
            "in": "query",
            "description": "Indica se o feed deve devolver apenas os incidentes do utilizador autenticado.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "lat",
            "required": false,
            "in": "query",
            "description": "Latitude do ponto de referência para o filtro por proximidade.",
            "schema": {
              "minimum": -90,
              "maximum": 90,
              "type": "number"
            }
          },
          {
            "name": "lng",
            "required": false,
            "in": "query",
            "description": "Longitude do ponto de referência para o filtro por proximidade.",
            "schema": {
              "minimum": -180,
              "maximum": 180,
              "type": "number"
            }
          },
          {
            "name": "radius",
            "required": false,
            "in": "query",
            "description": "Raio em metros para filtrar incidentes por proximidade.",
            "schema": {
              "minimum": 100,
              "maximum": 10000,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Lista incidentes ativos paginados.\nMétodo HTTP: GET /incidents",
        "tags": [
          "Incidents"
        ]
      }
    },
