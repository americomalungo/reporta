  "info": {
    "title": "Minha API",
    "description": "Documentação dos endpoints",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ReturnUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "alertsEnabled": {
            "type": "boolean"
          },
          "avatarUrl": {
            "type": "string"
          },
          "alertRadiusM": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "email",
          "phone",
          "alertsEnabled",
          "avatarUrl"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri"
          },
          "phone": {
            "type": "string"
          },
          "lastLatitude": {
            "type": "number"
          },
          "lastLongitude": {
            "type": "number"
          },
          "alertsEnabled": {
            "type": "boolean"
          },
          "alertRadiusM": {
            "type": "number",
            "minimum": 1000
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {}
      },
      "CreateIncidentDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "address": {
            "type": "string",
            "maxLength": 255
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          }
        },
        "required": [
          "categoryId",
          "title",
          "description",
          "latitude",
          "longitude"
        ]
      },
      "ReturnIncidentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único do incidente."
          },
          "authorId": {
            "type": "string",
            "description": "Identificador do autor do incidente."
          },
          "categoryId": {
            "type": "string",
            "description": "Identificador da categoria associada."
          },
          "title": {
            "type": "string",
            "description": "Título do incidente."
          },
          "description": {
            "type": "string",
            "description": "Descrição detalhada do incidente."
          },
          "address": {
            "type": "string",
            "nullable": true,
            "description": "Endereço textual do incidente, quando disponível."
          },
          "status": {
            "type": "string",
            "description": "Estado atual do incidente."
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string",
            "description": "Data de expiração do incidente."
          },
          "confirmCount": {
            "type": "number",
            "description": "Quantidade de confirmações recebidas."
          },
          "disconfirmCount": {
            "type": "number",
            "description": "Quantidade de desconfirmações recebidas."
          },
          "commentCount": {
            "type": "number",
            "description": "Número de comentários associados."
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Data de criação do incidente."
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Data da última atualização do incidente."
          },
          "latitude": {
            "type": "number",
            "description": "Latitude da localização do incidente."
          },
          "longitude": {
            "type": "number",
            "description": "Longitude da localização do incidente."
          },
          "distanceM": {
            "type": "number",
            "nullable": true,
            "description": "Distância em metros até o ponto de referência do filtro, ou null quando não existe filtro de proximidade."
          },
          "myVote": {
            "nullable": true,
            "description": "Voto atual do utilizador autenticado, se existir.",
            "enum": [
              "CONFIRM",
              "DISCONFIRM"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "authorId",
          "categoryId",
          "title",
          "description",
          "address",
          "status",
          "expiresAt",
          "confirmCount",
          "disconfirmCount",
          "commentCount",
          "createdAt",
          "updatedAt",
          "latitude",
          "longitude",
          "distanceM",
          "myVote"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "isRisk": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "isRisk"
        ]
      },
      "ReturnCategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "color": {
            "type": "string",
            "nullable": true
          },
          "isRisk": {
            "type": "boolean"
          },
          "slug": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "color",
          "isRisk",
          "slug",
          "isActive"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "VoteIncidentDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo do voto: confirmação ou desconfirmação.",
            "enum": [
              "CONFIRM",
              "DISCONFIRM"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "ReturnVoteDto": {
        "type": "object",
        "properties": {
          "incidentId": {
            "type": "string",
            "description": "Identificador do incidente."
          },
          "myVote": {
            "nullable": true,
            "description": "Voto atual do utilizador autenticado, ou null se ainda não votou.",
            "enum": [
              "CONFIRM",
              "DISCONFIRM"
            ],
            "type": "string"
          },
          "confirmCount": {
            "type": "number",
            "description": "Total de confirmações do incidente."
          },
          "disconfirmCount": {
            "type": "number",
            "description": "Total de desconfirmações do incidente."
          }
        },
        "required": [
          "incidentId",
          "myVote",
          "confirmCount",
          "disconfirmCount"
        ]
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Conteúdo do comentário, com trim e limite máximo de 1000 caracteres.",
            "maxLength": 1000
          },
          "parentId": {
            "type": "string",
            "description": "Id do comentário pai quando a mensagem for uma resposta."
          }
        },
        "required": [
          "content"
        ]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "avatarUrl"
        ]
      },
      "ReturnCommentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id do comentário."
          },
          "incidentId": {
            "type": "string",
            "description": "Id do incidente a que o comentário pertence."
          },
          "parentId": {
            "type": "string",
            "nullable": true,
            "description": "Id do comentário pai, ou null quando é um comentário principal."
          },
          "content": {
            "type": "string",
            "description": "Conteúdo do comentário."
          },
          "author": {
            "description": "Dados públicos do autor do comentário.",
            "allOf": [
              {
