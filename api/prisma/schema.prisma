generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../generated/prisma"
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, postgis]
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum IncidentStatus {
  ACTIVE
  EXPIRED
  UNDER_REVIEW // ADICIONADO: Para moderação automática por denúncias
  REMOVED
  DELETED
}

enum VoteType {
  CONFIRM
  DISCONFIRM
}

enum NotificationType {
  INCIDENT_CONFIRMED
  INCIDENT_DISCONFIRMED
  INCIDENT_REMOVED
  RISK_ALERT
  POSTING_RESTRICTED
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  ACCOUNT_REACTIVATED
  ADMIN_MESSAGE
  SYSTEM
}

enum PushPlatform {
  ANDROID
  IOS
  WEB
}

enum ModerationAction {
  BAN_USER
  SUSPEND_USER
  UNBAN_USER
  UNSUSPEND_USER
  PROMOTE_ADMIN
  DEMOTE_ADMIN
  REMOVE_INCIDENT
  RESTORE_INCIDENT
  EDIT_CATEGORY
  RESTRICT_POSTING
  LIFT_POSTING_RESTRICTION
  DISMISS_REPORT
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ReputationAction {
  INCIDENT_CREATED
  INCIDENT_CONFIRMED_BY_OTHERS
  USEFUL_COMMENT
  INCIDENT_REMOVED_PENALTY
  FALSE_REPORT_PENALTY
}

// ------------------------------------------------------------
// USUÁRIOS
// ------------------------------------------------------------

model User {
  id          String  @id @default(cuid())
  firebaseUid String  @unique
  email       String  @unique
  name        String
  avatarUrl   String?
  phone       String?

  role   UserRole      @default(USER)
  status AccountStatus @default(ACTIVE)

  // Gamificação / Reputação
  reputationScore Int @default(0)

  // Suspensão / banimento
  statusReason    String?
  statusChangedAt DateTime?
  suspendedUntil  DateTime?
  statusChangedBy String?

  // Bloqueio de postagem (1 mês)
  postingBlockedUntil DateTime?

  // Posts removidos por excesso de desconfirmações (3 => conta banida)
  removedPostsCount Int @default(0)

  // Última localização conhecida (alertas de proximidade)
  lastLatitude   Float?
  lastLongitude  Float?
  lastLocationAt DateTime?

  // Preferências
  alertsEnabled Boolean @default(true)
  alertRadiusM  Int     @default(1000)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  incidents        Incident[]
  votes            Vote[]
  comments         Comment[]
  notifications    Notification[]
  pushTokens       PushToken[]
  moderationsDone  ModerationLog[]     @relation("ModerationAdmin")
  moderationsTaken ModerationLog[]     @relation("ModerationTarget")
  alertDeliveries  AlertDelivery[]
  statusHistory    UserStatusHistory[]
  reputationLogs   ReputationLog[]
  interestZones    UserInterestZone[]

  @@index([role])
  @@index([status])
  @@index([reputationScore])
  @@index([lastLatitude, lastLongitude])
  @@map("users")
}

model UserStatusHistory {
  id         String        @id @default(cuid())
  userId     String
  fromStatus AccountStatus
  toStatus   AccountStatus
  reason     String?
  until      DateTime?
  changedBy  String?
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_status_history")
}

model ReputationLog {
  id        String           @id @default(cuid())
  userId    String
  points    Int
  action    ReputationAction
  reason    String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("reputation_logs")
}

model UserInterestZone {
  id     String @id @default(cuid())
  userId String
  name   String

  // Polígono espacial representando a zona delimitada
  area Unsupported("geography(Polygon, 4326)")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_interest_zones")
}

// ------------------------------------------------------------
// TOKENS PUSH (FCM) - notificações com app fechado
// ------------------------------------------------------------

model PushToken {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String       @unique
  platform  PushPlatform
  deviceId  String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

// ------------------------------------------------------------
// CATEGORIAS
// ------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique // "fogo", "iluminacao", "estradas", "lixo"
  name        String
  description String?
  icon        String?
  color       String?
  isActive    Boolean @default(true)
  isRisk      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents Incident[]

  @@index([isRisk])
  @@map("categories")
}

// ------------------------------------------------------------
// INCIDENTES
// ------------------------------------------------------------

model Incident {
  id          String  @id @default(cuid())
  authorId    String
  categoryId  String
  title       String
  description String
  latitude    Float
  longitude   Float
  address     String?

  // Coluna espacial do PostGIS para consultas de proximidade
  location Unsupported("geography(Point, 4326)")?

  status IncidentStatus @default(ACTIVE)

  // createdAt + 48h (definido pela aplicação na criação)
  expiresAt DateTime

  // Contadores desnormalizados
  confirmCount    Int @default(0)
  disconfirmCount Int @default(0)
  commentCount    Int @default(0)

  // Remoção
  removedAt     DateTime?
  removedReason String?
  removedBy     String? // admin id, ou null se automático

  // Alerta de risco
  alertDispatchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  media           IncidentMedia[]
  votes           Vote[]
  comments        Comment[]
  notifications   Notification[]
  alertDeliveries AlertDelivery[]

  @@index([status, expiresAt])
  @@index([categoryId, status, createdAt])
  @@index([authorId])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "incidents_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "incidents_description_trgm_idx")
  @@map("incidents")
}

model IncidentMedia {
  id         String    @id @default(cuid())
  incidentId String
  incident   Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       MediaType @default(IMAGE)
  bucket     String    @default("incident-media")
  path       String
  url        String
  mimeType   String?
  sizeBytes  Int?
  width      Int?
  height     Int?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([incidentId])
  @@map("incident_media")
}

// ------------------------------------------------------------
// VOTOS (confirmar / desconfirmar)
// ------------------------------------------------------------

model Vote {
  id         String   @id @default(cuid())
  incidentId String
  userId     String
  type       VoteType
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, userId])
  @@index([incidentId, type])
  @@index([userId])
  @@map("votes")
}

// ------------------------------------------------------------
// COMENTÁRIOS
// ------------------------------------------------------------

model Comment {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  isHidden   Boolean  @default(false)

  // ADICIONADO: Auto-relação para suporte a comentários aninhados (respostas)
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([incidentId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@map("comments")
}

// ------------------------------------------------------------
// NOTIFICAÇÕES (dentro do app + push)
// ------------------------------------------------------------

model Notification {
  id         String  @id @default(cuid())
  userId     String
  title      String
  body       String
  incidentId String?
  data       Json? // dados extras para deep link

  isRead Boolean   @default(false)
  readAt DateTime?

  pushSent   Boolean   @default(false)
  pushSentAt DateTime?

  createdAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     NotificationType
  incident Incident?        @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([incidentId])
  @@map("notifications")
}

model AlertDelivery {
  id          String   @id @default(cuid())
  userId      String
  incidentId  String
  distanceM   Float?
  deliveredAt DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, userId])
  @@index([userId])
  @@map("alert_deliveries")
}

// ------------------------------------------------------------
// ADMINISTRAÇÃO - auditoria
// ------------------------------------------------------------

model ModerationLog {
  id String @id @default(cuid())

  action       ModerationAction
  adminId      String? // null = ação automática do sistema
  incidentId   String?
  reason       String?
  metadata     Json?
  targetUserId String?

  createdAt DateTime @default(now())

  admin      User? @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  targetUser User? @relation("ModerationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([incidentId, createdAt])
  @@index([targetUserId])
  @@index([action])
  @@map("moderation_logs")
}
